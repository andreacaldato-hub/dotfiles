
// niri config (KDL) - https://yalter.github.io/niri/Configuration:-Introduction

// ───────────── Workspaces ─────────────
workspace "Main"
workspace "2-Browser"

// ───────────── Input ─────────────
input {
    keyboard {
        repeat-delay 200
        repeat-rate 35
        xkb {
            layout "us"
            variant "intl"
        }
    }

    touchpad {
        tap
        natural-scroll
    }

    mouse {
        accel-speed 0
        accel-profile "flat"
    }
}

environment {
    QT_QPA_PLATFORM "wayland"
}

// ───────────── Layout ─────────────
layout {
    gaps 15

    preset-column-widths {
        proportion 0.33333
        proportion 0.8
        proportion 0.66667
    }

    default-column-width { proportion 0.5; }

    focus-ring {
        width 1
        active-color "#2f3339"
        inactive-color "black"
    }

    shadow {
        on
        softness 30
        spread 5
        offset x=0 y=5
        color "#0007"
    }
}

// ───────────── General ─────────────
prefer-no-csd

hotkey-overlay {
    skip-at-startup
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

spawn-at-startup "noctalia"

// ───────────── Window rules ─────────────
// Rounded corners on every window
window-rule {
    geometry-corner-radius 20
    clip-to-geometry true
}

window-rule {
    match app-id="Alacritty"
    open-maximized true
}

window-rule {
    match app-id="firefox"
    open-maximized true
    open-on-workspace "2-Browser"
}

window-rule {
    match app-id="spotify"
    open-on-workspace "4-Music"
}

window-rule {
    match app-id="ski"
    open-floating true
    default-column-width { fixed 1200; }
    default-window-height { fixed 600; }
}

// Noctalia Settings: floating, centered by niri
window-rule {
    match app-id="dev.noctalia.Noctalia"
    open-floating true
}

// ───────────── Keybinds ─────────────
binds {
    // ── Apps ──
    Super+S               hotkey-overlay-title="Settings"                     { spawn-sh "noctalia msg settings-open"; }
    Super+N               hotkey-overlay-title="Settings"                     { spawn-sh "noctalia msg settings-open-network"; }
    Super+Return          hotkey-overlay-title="Terminal"                     { spawn "alacritty"; }
    Super+F               hotkey-overlay-title="Browser"                      { spawn "firefox"; }
    Super+E               hotkey-overlay-title="File manager"                 { spawn "ski"; }
    Super+A               hotkey-overlay-title="App launcher"                 { spawn-sh "noctalia msg panel-toggle launcher"; }
    Super+C               hotkey-overlay-title="Clipboard history"            { spawn-sh "noctalia msg panel-toggle clipboard"; }
    Super+D               hotkey-overlay-title="Default apps"                 { spawn-sh "noctalia msg panel-toggle thaer99ob/default-apps:manager"; }
    Super+W               hotkey-overlay-title="Wallpapers"                   { spawn-sh "noctalia msg panel-toggle wallpaper"; }
    Super+Shift+W         hotkey-overlay-title="Wallpapers (Wallhaven)"       { spawn-sh "noctalia msg panel-toggle noctalia/wallhaven:browser"; }

    // ── Tools ──
    Super+Shift+S               hotkey-overlay-title="Screenshot"                   { spawn "~/.config/niri/scripts/screenshot.sh"; }
    // hyprpicker 0.4.8 needs ext-image-copy-capture (missing in niri 26.04): using local 0.4.7 (wlr-screencopy)
    Super+P               hotkey-overlay-title="Color picker"                 { spawn-sh "~/.local/bin/hyprpicker -a"; }

    // ── System ──
    Super+Shift+K         hotkey-overlay-title="Keybinds cheatsheet"          { spawn "noctalia" "msg" "panel-toggle" "kenn/keybind-cheatsheet:cheatsheet"; }
    Super+Shift+Q         hotkey-overlay-title="LogOut"                       { quit skip-confirmation=true; }
    Super+Alt+L           hotkey-overlay-title="Lock screen"                  { spawn "swaylock"; }

    // ── Audio ──
    Super+Shift+Equal     hotkey-overlay-title="Volume +10%"                  { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1+ -l 1.0"; }
    Super+Shift+Minus     hotkey-overlay-title="Volume -10%"                  { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.1-"; }
    Super+M               hotkey-overlay-title="Mute audio"                   { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle"; }
    Super+Shift+M         hotkey-overlay-title="Mute microphone"              { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }

    // ── Brightness ──
    XF86MonBrightnessUp   hotkey-overlay-title="Brightness +10%"              { spawn "brightnessctl" "--class=backlight" "set" "+10%"; }
    XF86MonBrightnessDown hotkey-overlay-title="Brightness -10%"              { spawn "brightnessctl" "--class=backlight" "set" "10%-"; }

    // ── Window: state ──
    Super+Q               hotkey-overlay-title="Close window"                 { close-window; }
    Super+T               hotkey-overlay-title="Toggle floating"              { toggle-window-floating; }
    Super+Shift+T         hotkey-overlay-title="Switch focus floating/tiling" { switch-focus-between-floating-and-tiling; }

    // ── Window: size ──
    Super+O               hotkey-overlay-title="Column width -10%"            { set-column-width "-10%"; }
    Super+Shift+O         hotkey-overlay-title="Column width +10%"            { set-column-width "+10%"; }
    Super+Shift+F         hotkey-overlay-title="Maximize column"              { maximize-column; }
    Super+V               hotkey-overlay-title="Window height -10%"           { set-window-height "-10%"; }
    Super+Shift+V         hotkey-overlay-title="Window height +10%"           { set-window-height "+10%"; }
    Super+Shift+R         hotkey-overlay-title="Reset window height"          { reset-window-height; }

    // ── Window: column stacking ──
    Super+Comma           hotkey-overlay-title="Horizontal split"             { consume-window-into-column; }
    Super+Period          hotkey-overlay-title="Vertical split"               { expel-window-from-column; }

    // ── Focus ──
    Super+H               hotkey-overlay-title="Focus left"                   { focus-column-left; }
    Super+L               hotkey-overlay-title="Focus right"                  { focus-column-right; }
    Super+J               hotkey-overlay-title="Focus down"                   { focus-window-down; }
    Super+K               hotkey-overlay-title="Focus up"                     { focus-window-up; }

    // ── Move window / column ──
    Super+Shift+H         hotkey-overlay-title="Move column left"             { move-column-left; }
    Super+Shift+L         hotkey-overlay-title="Move column right"            { move-column-right; }

    // ── Workspaces: focus ──
    Super+1               hotkey-overlay-title="Go to workspace 1"            { focus-workspace "Main"; }
    Super+2               hotkey-overlay-title="Go to workspace 2"            { focus-workspace "2-Browser"; }
    Super+3               hotkey-overlay-title="Go to workspace 3"            { focus-workspace "3-Other"; }
    Super+4               hotkey-overlay-title="Go to workspace 4"            { focus-workspace "4-Music"; }
    Super+5               hotkey-overlay-title="Go to workspace 5"            { focus-workspace 5; }
    Super+6               hotkey-overlay-title="Go to workspace 6"            { focus-workspace 6; }
    Super+7               hotkey-overlay-title="Go to workspace 7"            { focus-workspace 7; }
    Super+8               hotkey-overlay-title="Go to workspace 8"            { focus-workspace 8; }
    Super+9               hotkey-overlay-title="Go to workspace 9"            { focus-workspace 9; }

    // ── Workspaces: move window (Shift) ──
    Super+Shift+1         hotkey-overlay-title="Move to workspace 1"          { move-window-to-workspace "Main"; }
    Super+Shift+2         hotkey-overlay-title="Move to workspace 2"          { move-window-to-workspace "2-Browser"; }
    Super+Shift+3         hotkey-overlay-title="Move to workspace 3"          { move-window-to-workspace "3-Other"; }
    Super+Shift+4         hotkey-overlay-title="Move to workspace 4"          { move-window-to-workspace "4-Music"; }
}
